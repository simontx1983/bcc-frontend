{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Files knip would flag as unused but that are intentionally kept.
  // Every entry needs a reason; remove the entry when the reason is gone.
  "ignore": [
    // Live: registered at runtime via navigator.serviceWorker.register()
    // in src/lib/push/register.ts, so there's no static import for knip to see.
    "public/sw.js"
  ],
  // Used via `next lint`, which knip can't trace.
  "ignoreDependencies": [
    "eslint",
    "eslint-config-next"
  ]
}
