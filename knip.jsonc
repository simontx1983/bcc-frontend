{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Files knip would flag as unused but that are intentionally kept.
  // Every entry needs a reason; remove the entry when the reason is gone.
  "ignore": [
    // Live: registered at runtime via navigator.serviceWorker.register()
    // in src/lib/push/register.ts, so there's no static import for knip to see.
    "public/sw.js",
    // Orphaned by the feed-redesign WIP (c8daf27), NOT retired. The §O2
    // Highlights feature is otherwise fully wired (backend + hooks + 4 live
    // cache invalidations). Kept pending the reconnect-or-remove decision.
    // Remove this line when that is resolved. See:
    // https://github.com/simontx1983/bcc-frontend/issues/83
    "src/components/feed/HighlightStrip.tsx"
  ],
  // Used via `next lint`, which knip can't trace.
  "ignoreDependencies": [
    "eslint",
    "eslint-config-next"
  ]
}
